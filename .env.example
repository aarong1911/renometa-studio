# Server-only Netlify variables (never prefix these with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
MAKE_CONTACT_WEBHOOK_URL=
MAKE_APPOINTMENT_WEBHOOK_URL=

# Try Agent abuse/cost protection — server-only secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs the browser-identity cookie (netlify/functions/_shared/cookies.cjs)
TRY_AGENT_COOKIE_SECRET=
# Hashes client IPs and browser ids before they're ever stored
TRY_AGENT_ABUSE_HASH_SECRET=
# Signs the internal setup-agent -> crawl-and-index-background handoff
TRY_AGENT_INTERNAL_SECRET=

# Cloudflare Turnstile — TURNSTILE_SECRET_KEY is server-only (Netlify
# Function env var); VITE_TURNSTILE_SITE_KEY is a public build-time variable
# and is safe to expose to the browser.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Try Agent rate limits (all optional — safe defaults shown)
TRY_AGENT_EMAIL_LIMIT=2
TRY_AGENT_BROWSER_LIMIT=2
TRY_AGENT_DOMAIN_LIMIT=2
TRY_AGENT_IP_LIMIT=6
TRY_AGENT_GLOBAL_LIMIT=100
TRY_AGENT_WINDOW_HOURS=24
TRY_AGENT_QUERY_LIMIT=10
